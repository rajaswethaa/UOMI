NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=uomi
DB_SSL=false
DB_AUTO_MIGRATE=true

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# CORS: "*" or a comma separated list of origins
CORS_ORIGIN=*
